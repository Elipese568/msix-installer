<?xml version="1.0" encoding="utf-8"?>
<!--
  这个样例只从本地 feed 取包，刻意 <clear /> 掉机器上的全局源：
    1) 验收要证明的是「包本身自洽」，不该受开发机上别的源与缓存影响；
    2) 本样例除 Msixpkg.Build 外没有任何 PackageReference，离线也能复现（CI 与受限网络里同样跑得通）。

  本地 feed 由 scripts\pack-nuget.ps1 产出（默认 artifacts\nuget）。真实项目里这一行要换成 nuget.org。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="msixpkg-local" value="..\..\artifacts\nuget" />
  </packageSources>
</configuration>
