// setup / Uninstall.exe 的版本信息与图标。版本号由 CMake 从 res/msixpkg.rc 的
// FILEVERSION 解析后注入，保证「属性 → 详细信息」、ARP 与包名一致。

#include <winres.h>

// 必须与 setup_ui.cpp 的 LoadIconW(MAKEINTRESOURCEW(IDI_MSIXPKG)) 一致：
// rc 里如果只写一个未定义的名字，它会变成字符串资源名，运行时按整数 1 找不到图标。
#define IDI_MSIXPKG 1

IDI_MSIXPKG ICON "@MSIXPKG_SETUP_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MSIXPKG_SETUP_VERSION_COMMA@
 PRODUCTVERSION @MSIXPKG_SETUP_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MsixpkgInstaller"
            VALUE "FileDescription", "@MSIXPKG_SETUP_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@MSIXPKG_SETUP_VERSION_QUAD@"
            VALUE "InternalName", "@MSIXPKG_SETUP_INTERNAL_NAME@"
            VALUE "OriginalFilename", "@MSIXPKG_SETUP_INTERNAL_NAME@.exe"
            VALUE "ProductName", "Msixpkg Installer"
            VALUE "ProductVersion", "@MSIXPKG_SETUP_VERSION_QUAD@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
