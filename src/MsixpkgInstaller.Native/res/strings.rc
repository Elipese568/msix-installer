    318 "You must tick the consent box before installing."
    319 "You must explicitly trust this publisher before installing it."
    320 "Copy fingerprint"

    // ---------- 进度页 ----------
    400 "Installing"
    401 "Working..."
    402 "Please wait. The installer is not responding to input while a step is running."
    403 "%u%% complete"
    404 "Waiting for administrator confirmation..."
    405 "Checking the container"
    406 "Extracting the payload"
    407 "Importing the publisher certificate"
    408 "Installing dependencies"
    409 "Installing the main package"
