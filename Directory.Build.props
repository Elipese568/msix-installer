<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>MsixpkgInstaller</Company>
    <Product>Msixpkg Installer</Product>
    <Version>0.1.0</Version>
    <Copyright>Copyright (c) MsixpkgInstaller contributors</Copyright>
    <DebugType>portable</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultNoneItems>true</EnableDefaultNoneItems>
    <!-- 分析器在 M1 阶段先关闭以便快速迭代，M7 再打开并按需修正（CA 规则不阻塞功能实现）。 -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

</Project>
